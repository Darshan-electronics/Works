[Unit]
Description=Darshan JARVIS 2.0
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/Works/Darshan-JARVIS-2.0
EnvironmentFile=%h/Works/Darshan-JARVIS-2.0/.env
ExecStart=%h/Works/Darshan-JARVIS-2.0/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
