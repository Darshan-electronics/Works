# JARVIS core
JARVIS_ACCESS_TOKEN=
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=embeddinggemma

# Research
WEB_RESEARCH_ENABLED=true
SEARXNG_URL=http://127.0.0.1:8081
SEARXNG_FALLBACK_URLS=http://127.0.0.1:8888

# Safety
REQUIRE_CONFIRMATION_MEDIUM=true
REQUIRE_CONFIRMATION_HIGH=true
REQUIRE_CONFIRMATION_CRITICAL=true

# Optional cloud fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# GitHub
GITHUB_OWNER=Darshan-electronics
GITHUB_TOKEN=

# Optional voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v3

# Optional phone alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
JARVIS_PHONE_NUMBER=
JARVIS_PUBLIC_BASE_URL=
JARVIS_AUDIO_DIR=data/phone_audio
JARVIS_PHONE_GREETING=Hello. This is JARVIS, an AI assistant. I am calling you because you asked me to.

# Workspace
JARVIS_WORKSPACE=workspace
